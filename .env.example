# Copy to .env.local; never commit values. MCP credentials are NOT runtime credentials.
DATABASE_URL=
# Required by migration/seed scripts; production requires explicit migration approval flag.
DATABASE_ENV=development
APP_URL=http://localhost:3000
SESSION_COOKIE_SECURE=false
SHOPIFY_SHOP_DOMAIN=kaizjm-da.myshopify.com
SHOPIFY_API_VERSION=2026-10
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Private Storefront token (not public browser token).
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_LOCATION_ID=
SHOPIFY_PUBLICATION_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
PRICING_CACHE_HOURS=24
PHOTOROOM_API_KEY=
# Enable only if edit API entitlement verified, separate from segment entitlement.
PHOTOROOM_EDIT_ENABLED=false
BLOB_READ_WRITE_TOKEN=
# Public Blob store for explicitly approved selected variants only.
BLOB_PUBLIC_READ_WRITE_TOKEN=
STORAGE_DRIVER=blob
CRON_SECRET=
JOBS_MAX_CONCURRENCY=2
# Administrative CLI only, never client exposed; remove password after account creation.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ROLE=admin
# True also marks newly created products as demo; always false on cloud deployments.
DEMO_SEED=false
# Local verification only; NEVER deployed.
LOCAL_DATABASE_URL=postgresql://spotlight:local-test-only@127.0.0.1:5433/spotlight
